{
  "name": "@gang-of-beads/pi-web-background-runs",
  "version": "0.2.0",
  "description": "Background tasks for pi with their PI WEB half: pi-background-tasks' bg_run tools in the terminal and a Background page in PI WEB, from one install.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-web",
    "pi-web-plugin",
    "pi-background-tasks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gang-of-Beads/pi-web-background-runs.git"
  },
  "bugs": {
    "url": "https://github.com/Gang-of-Beads/pi-web-background-runs/issues"
  },
  "homepage": "https://github.com/Gang-of-Beads/pi-web-background-runs#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "piWeb": {
    "plugins": [
      {
        "id": "background-runs",
        "browserRoot": "dist/browser",
        "module": "dist/browser/pi-web-plugin.js",
        "serverModule": "dist/server-plugin.js",
        "sessionCommands": [
          "kill"
        ]
      }
    ],
    "bus": {
      "background-runs:tasks": {
        "kind": "state"
      },
      "background-runs:stop": {
        "kind": "request"
      },
      "background-runs:output": {
        "kind": "request"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@gang-of-beads/pi-web-plugin-api": "^0.1.0-alpha.10",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pi-background-tasks": "^2.6.10"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/anthropic-attribution.js",
      "./dist/extensions/background-tasks.js",
      "./dist/extensions/web-bridge.js"
    ]
  }
}
